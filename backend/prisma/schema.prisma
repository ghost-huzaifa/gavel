// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId String  @id @default(uuid())
  email  String  @unique
  name   String?

  bidder    Bidder?
  auctioner Auctioneer?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Bidder {
  bidderId String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [userId])

  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())
  bidderAuctions BidderAuction[]
}

model BidderAuction {
  bidderId  String
  auctionId String

  bidder  Bidder  @relation(fields: [bidderId], references: [bidderId])
  auction Auction @relation(fields: [auctionId], references: [auctionId])

  @@id([bidderId, auctionId])
}

model Auctioneer {
  auctionerId String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [userId])

  updatedAt          DateTime            @updatedAt
  createdAt          DateTime            @default(now())
  auctioneerAuctions AuctioneerAuction[]
}

model AuctioneerAuction {
  auctioneerId String
  auctionId    String

  auctioneer Auctioneer @relation(fields: [auctioneerId], references: [auctionerId])
  auction    Auction    @relation(fields: [auctionId], references: [auctionId])

  @@id([auctioneerId, auctionId])
}

model Auction {
  auctionId   String  @id @default(uuid())
  title       String
  description String?

  items Item[]

  updatedAt          DateTime            @updatedAt
  createdAt          DateTime            @default(now())
  bidderAuctions     BidderAuction[]
  auctioneerAuctions AuctioneerAuction[]
}

model Item {
  itemId      String  @id @default(uuid())
  name        String
  description String?

  minBid     Float
  currentBid Float?
  isSold     Boolean @default(false)

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [auctionId])

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

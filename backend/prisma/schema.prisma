// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId String  @id @default(uuid())
  name   String?

  bidderAuctions     Auction[] @relation("bidders")
  auctioneerAuctions Auction[] @relation("auctioneer")
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())
}

model Auction {
  auctionId   String  @id @default(uuid())
  title       String
  description String?

  auctioneerId String
  auctioneer   User   @relation("auctioneer", fields: [auctioneerId], references: [userId])
  bidders      User[] @relation("bidders")
  items        Item[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Item {
  itemId      String  @id @default(uuid())
  name        String
  description String?

  minBid     Float
  currentBid Float   @default(0)
  isSold     Boolean @default(false)

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [auctionId])

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId   String  @id @default(uuid())
  email    String  @unique
  password String
  name     String?

  bidder     Bidder?
  auctioneer Auctioneer?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Bidder {
  bidderId String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [userId])

  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())
  bidderAuctions BidderAuction[]
}

model BidderAuction {
  bidderId  String
  auctionId String

  bidder  Bidder  @relation(fields: [bidderId], references: [bidderId])
  auction Auction @relation(fields: [auctionId], references: [auctionId])

  @@id([bidderId, auctionId])
}

model Auctioneer {
  auctioneerId String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [userId])

  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())
  auctioneerAuctions Auction[]
}

model Auction {
  auctionId   String  @id @default(uuid())
  title       String
  description String?

  auctioneerId String
  auctioneer   Auctioneer @relation(fields: [auctioneerId], references: [auctioneerId])
  items        Item[]

  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())
  bidderAuctions BidderAuction[]
}

model Item {
  itemId      String  @id @default(uuid())
  name        String
  description String?

  minBid     Float
  currentBid Float   @default(0)
  isSold     Boolean @default(false)

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [auctionId])

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
